    },
    "url": {
      "type": "string"
    },
    "loopback_url": {
      "type": "string"
    },
    "urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "token": {
      "type": "string"
    },
    "deeplink": {
      "type": "string"
    },
    "allow_remote": {
      "type": "boolean"
    },
    "host": {
      "type": "string"
    },
    "port": {
      "type": "integer"
    },
    "shell": {
      "type": "string"
    },
    "cli": {
      "type": "string"
    }
  }
